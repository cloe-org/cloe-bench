# Machine-specific overrides of [environment] (see README).
local.toml
# Generated by the script: helper files of Blast and cosmosis, the standard library of cosmosis.
.work/
external/
# The Cl of every code and the shared inputs are committed (the root .gitignore excludes *.npz);
# Blast's intermediate files are not.
!data/*/*.npz
data/*/blast_inputs.npz
data/*/blast_raw.npz
data/*/blast_request.toml
data/*/blast_timings.toml
